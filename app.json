{
  "expo": {
    "name": "Telemetria E36 BLE",
    "slug": "poc-tcc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.maua.telemetria.poctcc"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.maua.telemetria.poctcc"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-ble-manager",
        {
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "O app usa o Bluetooth para ler a telemetria do módulo ESP32 instalado no carro."
        }
      ]
    ]
  }
}
